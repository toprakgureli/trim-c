<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TrimC.Desktop.Controls"
        xmlns:formatting="using:TrimC.Desktop.Formatting"
        xmlns:res="using:TrimC.Desktop.Resources"
        xmlns:vm="using:TrimC.Desktop.ViewModels"
        x:Class="TrimC.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/trim-c.ico"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <!--
    The main screen holds only what trimming needs: the video, the timeline with its handles and the playback
    controls. Export settings live in a dialog, and the segment list with the manual tools lives in a panel that opens
    on demand. Keyboard shortcuts are mapped in code-behind so that they are suppressed while a text box has focus.
  -->
  <Window.Styles>
    <Style Selector="Button.icon">
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#F87171" />
    </Style>
    <Style Selector="Button.zoom">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <!-- Top bar -->
    <Border Grid.Row="0" Padding="12,8" Background="#1E1F22">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="{x:Static res:Strings.OpenButton}" Command="{Binding OpenFileCommand}" CommandParameter="{x:Null}"
                ToolTip.Tip="{x:Static res:Strings.OpenTooltip}" />
        <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Text="{Binding MediaSummary}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Classes="icon" Content="&#x21B6;" Command="{Binding UndoCommand}" ToolTip.Tip="{x:Static res:Strings.UndoTooltip}" />
          <Button Classes="icon" Content="&#x21B7;" Command="{Binding RedoCommand}" ToolTip.Tip="{x:Static res:Strings.RedoTooltip}" />
          <ToggleButton Content="{x:Static res:Strings.AdvancedButton}" IsChecked="{Binding IsAdvancedPanelOpen}" ToolTip.Tip="{x:Static res:Strings.AdvancedTooltip}" />
          <Button Classes="icon" Content="&#x22EF;" ToolTip.Tip="{x:Static res:Strings.MoreTooltip}">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{x:Static res:Strings.MenuLanguage}">
                  <MenuItem Header="{x:Static res:Strings.LanguageSystem}" ToggleType="Radio" GroupName="language" IsChecked="{Binding IsLanguageSystem, Mode=OneWay}"
                            Command="{Binding SetLanguageCommand}" CommandParameter="" />
                  <MenuItem Header="{x:Static res:Strings.LanguageEnglish}" ToggleType="Radio" GroupName="language" IsChecked="{Binding IsLanguageEnglish, Mode=OneWay}"
                            Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                  <MenuItem Header="{x:Static res:Strings.LanguageTurkish}" ToggleType="Radio" GroupName="language" IsChecked="{Binding IsLanguageTurkish, Mode=OneWay}"
                            Command="{Binding SetLanguageCommand}" CommandParameter="tr" />
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MenuOpenWith}" ToggleType="CheckBox" IsChecked="{Binding ShowInOpenWith, Mode=TwoWay}"
                          IsVisible="{Binding CanIntegrateWithShell}" />
                <MenuItem Header="{x:Static res:Strings.MenuOpenLogs}" Command="{Binding OpenLogFolderCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Content="{x:Static res:Strings.ExportButton}" Classes="accent" Command="{Binding ExportCommand}" ToolTip.Tip="{x:Static res:Strings.ExportTooltip}" />
          <Button Content="{x:Static res:Strings.CancelExportButton}" Command="{Binding ExportCancelCommand}" IsVisible="{Binding IsExporting}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Video, with the advanced panel beside it when it is open -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Panel Grid.Column="0" Background="Black">
        <controls:VideoHost Player="{Binding Player}" IsVisible="{Binding HasMedia}" />
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" FontSize="16"
                   Text="{x:Static res:Strings.DropHint}" IsVisible="{Binding !HasMedia}" />
        <Border VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="4" Background="#CC000000"
                IsVisible="{Binding PlayerMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding PlayerMessage}" TextWrapping="Wrap" />
        </Border>
      </Panel>

      <Border Grid.Column="1" Width="330" Background="#26272B" Padding="14" IsVisible="{Binding IsAdvancedPanelOpen}">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Text="{x:Static res:Strings.SegmentsHeader}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SegmentViewModel">
                <Grid ColumnDefinitions="26,*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.RowSpan="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Number}" />
                  <TextBlock Grid.Column="1" FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding StartText}" />
                    <Run Text=" &#x2192; " />
                    <Run Text="{Binding EndText}" />
                  </TextBlock>
                  <StackPanel Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal" Spacing="6">
                    <!-- The same crossed-out speaker the timeline draws on a muted segment. -->
                    <Path VerticalAlignment="Center" Width="18" Height="16" Fill="#F87171" Stroke="#F87171" StrokeThickness="1.5"
                          Data="M0,5 L4,5 L9,1 L9,15 L4,11 L0,11 Z M12,5 L17,11 M12,11 L17,5"
                          IsVisible="{Binding IsMuted}" ToolTip.Tip="{x:Static res:Strings.MutedBadge}" />
                    <TextBlock Classes="caption" FontFamily="Consolas,Menlo,monospace" Text="{Binding DurationText}" />
                  </StackPanel>
                  <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" PlaceholderText="{x:Static res:Strings.SegmentLabelPlaceholder}" Text="{Binding Label}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Margin="0,0,6,6" Content="{x:Static res:Strings.RemoveButton}" Command="{Binding RemoveSelectedCommand}" ToolTip.Tip="{x:Static res:Strings.RemoveTooltip}" />
            <Button Margin="0,0,6,6" Content="{x:Static res:Strings.InvertButton}" Command="{Binding InvertSegmentsCommand}" ToolTip.Tip="{x:Static res:Strings.InvertTooltip}" />
            <Button Margin="0,0,6,6" Content="{x:Static res:Strings.ResetButton}" Command="{Binding ResetSegmentsCommand}" ToolTip.Tip="{x:Static res:Strings.ResetTooltip}" />
          </WrapPanel>

          <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="6">
            <TextBlock Text="{x:Static res:Strings.ManualToolsHeader}" FontWeight="SemiBold" FontSize="15" />
            <WrapPanel>
              <Button Margin="0,0,6,6" Content="{x:Static res:Strings.SetStartButton}" Command="{Binding SetMarkInCommand}" ToolTip.Tip="{x:Static res:Strings.SetStartTooltip}" />
              <Button Margin="0,0,6,6" Content="{x:Static res:Strings.SetEndButton}" Command="{Binding SetMarkOutCommand}" ToolTip.Tip="{x:Static res:Strings.SetEndTooltip}" />
              <Button Margin="0,0,6,6" Content="{x:Static res:Strings.SplitButton}" Command="{Binding SplitCommand}" ToolTip.Tip="{x:Static res:Strings.SplitTooltip}" />
              <Button Margin="0,0,6,6" Content="{x:Static res:Strings.CutOutButton}" Command="{Binding CutOutCommand}" ToolTip.Tip="{x:Static res:Strings.CutOutTooltip}" />
            </WrapPanel>
            <TextBlock Classes="caption" Text="{x:Static res:Strings.ManualToolsHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Playback controls and the summary of what will be kept -->
    <Border Grid.Row="2" Padding="12,6" Background="#1E1F22">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="icon" Content="&#x23EE;" Command="{Binding PreviousKeyframeCommand}" ToolTip.Tip="{x:Static res:Strings.PreviousKeyframeTooltip}" />
          <Button Classes="icon" Content="&#x25C0;" Command="{Binding StepBackwardCommand}" ToolTip.Tip="{x:Static res:Strings.PreviousFrameTooltip}" />
          <Button Classes="icon" Content="&#x23EF;" Command="{Binding TogglePlaybackCommand}" ToolTip.Tip="{x:Static res:Strings.PlayPauseTooltip}" />
          <Button Classes="icon" Content="&#x25B6;" Command="{Binding StepForwardCommand}" ToolTip.Tip="{x:Static res:Strings.NextFrameTooltip}" />
          <Button Classes="icon" Content="&#x23ED;" Command="{Binding NextKeyframeCommand}" ToolTip.Tip="{x:Static res:Strings.NextKeyframeTooltip}" />
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Consolas,Menlo,monospace" FontSize="15">
            <Run Text="{Binding Position, Converter={x:Static formatting:TimecodeConverter.Instance}}" />
            <Run Text=" / " Foreground="Gray" />
            <Run Text="{Binding Duration, Converter={x:Static formatting:TimecodeConverter.Instance}}" Foreground="Gray" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding HasMedia}">
          <TextBlock HorizontalAlignment="Right" Text="{Binding TrimSummary}" FontFamily="Consolas,Menlo,monospace" FontSize="14" Foreground="#FACC15" />
          <TextBlock HorizontalAlignment="Right" Classes="caption" Text="{x:Static res:Strings.TrimHint}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Timeline, with a scroll bar and zoom buttons for moving around a zoomed-in view -->
    <Grid Grid.Row="3" RowDefinitions="104,Auto">
      <controls:TimelineControl x:Name="Timeline"
                                Duration="{Binding Duration}"
                                Position="{Binding Position}"
                                Keyframes="{Binding Keyframes}"
                                Segments="{Binding TimelineSegments}"
                                SelectedSegmentId="{Binding SelectedSegmentId}"
                                MarkIn="{Binding MarkIn}"
                                SeekCommand="{Binding SeekCommand}"
                                SelectSegmentCommand="{Binding SelectSegmentCommand}"
                                TrimCommand="{Binding TrimCommand}">
        <controls:TimelineControl.SegmentMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static res:Strings.MenuRemoveSound}" Command="{Binding ToggleSoundCommand}" InputGesture="M" IsVisible="{Binding !IsSelectedMuted}" />
            <MenuItem Header="{x:Static res:Strings.MenuRestoreSound}" Command="{Binding ToggleSoundCommand}" InputGesture="M" IsVisible="{Binding IsSelectedMuted}" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.MenuDeleteClip}" Command="{Binding RemoveSelectedCommand}" InputGesture="Delete" />
          </ContextMenu>
        </controls:TimelineControl.SegmentMenu>
      </controls:TimelineControl>

      <Border Grid.Row="1" Padding="8,3" Background="#1E1F22" IsVisible="{Binding HasMedia}">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollBar Orientation="Horizontal" VerticalAlignment="Center" AllowAutoHide="False" Minimum="0"
                     Maximum="{Binding #Timeline.ScrollMaximum}"
                     ViewportSize="{Binding #Timeline.ScrollViewport}"
                     LargeChange="{Binding #Timeline.ScrollViewport}"
                     Value="{Binding #Timeline.ScrollOffset, Mode=TwoWay}"
                     IsEnabled="{Binding #Timeline.IsZoomed}" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" Spacing="4">
            <Button Classes="zoom" Content="&#x2212;" Click="OnZoomOut" ToolTip.Tip="{x:Static res:Strings.ZoomOutTooltip}" />
            <Button Classes="zoom" Content="+" Click="OnZoomIn" ToolTip.Tip="{x:Static res:Strings.ZoomInTooltip}" />
            <Button Classes="zoom" Content="{x:Static res:Strings.ZoomFitButton}" Click="OnZoomToFit" IsEnabled="{Binding #Timeline.IsZoomed}"
                    ToolTip.Tip="{x:Static res:Strings.ZoomFitTooltip}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="4" Padding="12,4" Background="#1E1F22">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" Classes.error="{Binding IsStatusError}" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" Width="220" Margin="12,0" Minimum="0" Maximum="100" Value="{Binding ExportPercent}" IsVisible="{Binding IsExporting}" />
        <Button Grid.Column="2" Padding="8,2" Content="{x:Static res:Strings.ShowInFolderButton}" Command="{Binding RevealLastExportCommand}"
                IsVisible="{Binding LastExportedFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>

  </Grid>
</Window>
