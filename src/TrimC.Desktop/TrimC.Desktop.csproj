<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation layer: an Avalonia desktop application using the MVVM pattern.
    Video preview is rendered by libmpv into a native child window, which gives hardware decoding
    and frame-accurate seeking without routing frames through managed code.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TrimC.Desktop</RootNamespace>
    <AssemblyName>trim-c</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrimC.Core\TrimC.Core.csproj" />
    <ProjectReference Include="..\TrimC.FFmpeg\TrimC.FFmpeg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
