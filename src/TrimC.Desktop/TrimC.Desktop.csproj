<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation layer: an Avalonia desktop application using the MVVM pattern.
    Video preview is rendered by libmpv into a native child window, which gives hardware decoding
    and frame-accurate seeking without routing frames through managed code.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TrimC.Desktop</RootNamespace>
    <AssemblyName>trim-c</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The icon is drawn from docs/images/logo.svg for 32 pixels and up, and from docs/images/logo-small.svg below that,
      where the frame around the play mark would blur into the handles. Explorer, the taskbar and the "Open with"
      entries all take it from the executable.
    -->
    <ApplicationIcon>Assets\trim-c.ico</ApplicationIcon>
    <!-- The interface ships in English and Turkish; satellite assemblies for other languages would only add size. -->
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrimC.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\trim-c.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrimC.Core\TrimC.Core.csproj" />
    <ProjectReference Include="..\TrimC.FFmpeg\TrimC.FFmpeg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
